#include"spi.h"

#define GPIOAEN   (1U << 0)
#define SPI1EN    (1U << 12)
#define __IO volatile


void spi1_init(void)
{
    /************ Enable Clocks ************/
    RCC->AHB2ENR |= GPIOAEN;   // Enable GPIOA clock
    RCC->APB2ENR |= SPI1EN;    // Enable SPI1 clock

    /************ Configure GPIOA pins ************/
    // PA5 = SCK, PA6 = MISO, PA7 = MOSI (AF5)
    GPIOA->MODER &= ~((3U << 10) | (3U << 12) | (3U << 14));  // clear
    GPIOA->MODER |=  ((2U << 10) | (2U << 12) | (2U << 14));  // set AF

    GPIOA->AFR[0] &= ~((0xF << 20) | (0xF << 24) | (0xF << 28));
    GPIOA->AFR[0] |=  ((5U << 20) | (5U << 24) | (5U << 28)); // AF5

    GPIOA->OSPEEDR |= (3U << 10) | (3U << 12) | (3U << 14);   // Very High speed
    GPIOA->OTYPER  &= ~((1U << 5) | (1U << 6) | (1U << 7));   // Push-pull
    GPIOA->PUPDR   &= ~((3U << 10) | (3U << 12) | (3U << 14));// No pull-up/down

    /************ Configure SPI1 ************/
    SPI1->CR1 = 0;   // Reset

    SPI1->CR1 |= (1U << 2);     // Master mode
    SPI1->CR1 |= (0x4 << 3);    // Baud rate = fPCLK/32 (adjust as needed)
    SPI1->CR1 &= ~(1U << 7);    // MSB first
    SPI1->CR1 &= ~(1U << 11);   // 8-bit data format
    SPI1->CR1 &= ~(1U << 1);    // CPOL = 0
    SPI1->CR1 &= ~(1U << 0);    // CPHA = 0
    SPI1->CR1 |=  (1U<<9);
    if(SPI1->CR1 & (1<<9))
    {
    	SPI1->CR1 |= (1U<<8);
    }
    SPI1->CR2 |= (1U << 12);
    SPI1->CR2 = 0;
    SPI1->CR2 |= (7U << 8);     // Data size = 8 bits (DS[3:0] = 0111)

    SPI1->CR1 |= (1U << 6);     // Enable SPI1 (SPE)
}

void spi1_transmit_receive(uint8_t *tx_buf, uint8_t *rx_buf, uint32_t len)
{
    for (uint32_t i = 0; i < len; i++)
    {
        while (!(SPI1->SR & (1U << 1)));   // Wait until TXE
        *((__IO uint8_t*)&SPI1->DR) = tx_buf[i]; // Write to DR

        while (!(SPI1->SR & (1U << 0)));   // Wait until RXNE
        rx_buf[i] = *((__IO uint8_t*)&SPI1->DR); // Read from DR
    }
}
